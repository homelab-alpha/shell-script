# Git Ignore (Blocklist)

# --- Local development files ---
# Notes and the local Super Linter log stay out of the repository.
notes.md
super_linter.log

# --- Database Files ---
# MySQL/MariaDB
*.db
*.frm
*.ib_logfile*
*.ibd
*.MRG
*.myd
*.myi
*.ndb
*.ndbcluster
*.sock

# PostgreSQL
*.backup
*.pid
*.sql

# Redis
*.aof
*.rdb

# SQLite
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# --- Build Systems ---
# Coverage Files

# Docker
docker-compose.override.yml

# Environment and Configuration Files
.env
stack.env

# External Dependencies
composer.lock

# Folders
.vscode/
build/
dist/
node_modules/
out/

# IDEs and Editors
.idea/.name
.idea/workspace.xml
*.iml
*.iws
*.sublime-project
*.sublime-workspace

# Logs
*.binlog
*.err
*.log
*.relaylog
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node.js
.eslintcache

# --- Programming Languages ---

# System Files
.DS_Store
.LSOverride
AppleDouble
Desktop.ini
ehthumbs.db
Icon\r
Thumbs.db

# Temporary Files and Folders
*.bak
*.swp
*.tmp
temp*
TEMP*

# Python
__pycache__/
*.py[cod]

# Vim/Neovim
*.swo
*.swp

# --- Claude Code ---
# Personal settings stay local.
.claude/settings.local.json

# --- Tracked exceptions ---
# A line that starts with ! only works after the pattern it undoes, so this
# block stays at the end. These files are tracked even if a pattern above
# matches them.
!super_linter.env
