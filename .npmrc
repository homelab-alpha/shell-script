# Supply-chain hardening for the dev tooling (Prettier and textlint).

# Never run install scripts (preinstall, install, postinstall) of dependencies.
ignore-scripts=true

# Refuse to install on a Node.js version outside `engines` in package.json.
engine-strict=true

# Save exact versions, never ranges.
save-exact=true

# `npm audit` fails on high and critical advisories.
audit-level=high

# Only the public npm registry.
registry=https://registry.npmjs.org/
