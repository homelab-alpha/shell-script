{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests",
    ":enablePreCommit",
    ":semanticCommits",
    ":rebaseStalePrs"
  ],
  "dependencyDashboard": true,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "addLabels": ["security"]
  },
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "timezone": "Europe/Amsterdam",
  "schedule": [],
  "rangeStrategy": "bump",
  "ignoreDeps": [],
  "ignorePaths": [],
  "assignees": ["homelab-alpha"],
  "reviewers": ["homelab-alpha"],
  "automerge": false,
  "packageRules": [
    {
      "description": "Pin npm dependencies to exact versions, but not the engines range",
      "matchManagers": ["npm"],
      "rangeStrategy": "pin",
      "matchDepTypes": ["dependencies", "devDependencies"]
    },
    {
      "description": "Group the first digest pins of all container images in one pull request",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["pin"],
      "groupName": "container image digests"
    },
    {
      "description": "Update indirect Go modules (Hugo modules), so go.mod and go.sum stay current",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "enabled": true
    },
    {
      "description": "Prioritize security updates",
      "matchPackageNames": ["*"],
      "isVulnerabilityAlert": true,
      "prPriority": 100,
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Keep Node.js on major version 24 (LTS)",
      "matchPackageNames": ["node", "@types/node"],
      "matchManagers": ["npm", "nodenv", "dockerfile"],
      "allowedVersions": "^24.0.0"
    },
    {
      "description": "General labeling for all updates",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance",
        "rollback",
        "bump",
        "replacement"
      ],
      "addLabels": ["{{{updateType}}}", "{{{depName}}}"]
    },
    {
      "description": "Mark dependencies",
      "matchDepTypes": ["dependencies"],
      "addLabels": ["dependencies"]
    },
    {
      "description": "Mark dev dependencies",
      "matchDepTypes": ["devDependencies"],
      "addLabels": ["dev dependencies"]
    }
  ],
  "internalChecksFilter": "strict",
  "minimumReleaseAge": "7 days",
  "customManagers": [
    {
      "description": "Track Hugo version in GitHub Actions workflows",
      "customType": "regex",
      "managerFilePatterns": ["/.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": ["HUGO_VERSION:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "hugo",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "packageNameTemplate": "gohugoio/hugo"
    },
    {
      "description": "Track Dart Sass version in GitHub Actions workflows",
      "customType": "regex",
      "managerFilePatterns": ["/.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "DART_SASS_VERSION:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "dart-sass",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "packageNameTemplate": "sass/dart-sass"
    }
  ]
}
