{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests",
    ":enablePreCommit",
    ":semanticCommits"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "addLabels": ["security"]
  },
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "timezone": "Europe/Amsterdam",
  "schedule": [],
  "rangeStrategy": "bump",
  "ignoreDeps": [],
  "ignorePaths": [],
  "assignees": [],
  "reviewers": ["homelab-alpha"],
  "automerge": false,
  "packageRules": [
    {
      "description": "Pin npm dependencies to exact versions, but not the engines range",
      "matchManagers": ["npm"],
      "rangeStrategy": "pin",
      "matchDepTypes": ["dependencies", "devDependencies"]
    },
    {
      "description": "Group the first digest pins of all container images in one pull request",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["pin"],
      "groupName": "container image digests"
    },
    {
      "description": "Group GitHub Actions patch, pin, and digest updates in one pull request, reviewed by a maintainer",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "pin", "pinDigest", "digest"],
      "groupName": "github actions (patch and digest)"
    },
    {
      "description": "Group pre-commit hook patch, pin, and digest updates in one pull request, reviewed by a maintainer",
      "matchManagers": ["pre-commit"],
      "matchUpdateTypes": ["patch", "pin", "pinDigest", "digest"],
      "groupName": "pre-commit hooks (patch and digest)"
    },
    {
      "description": "Group GitHub Actions minor updates in one pull request, reviewed by a maintainer",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor"],
      "groupName": "github actions (minor)"
    },
    {
      "description": "Group pre-commit hook minor updates in one pull request, reviewed by a maintainer",
      "matchManagers": ["pre-commit"],
      "matchUpdateTypes": ["minor"],
      "groupName": "pre-commit hooks (minor)"
    },
    {
      "description": "Group all npm non-major updates in one pull request, reviewed by a maintainer",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "groupName": "npm (non-major)"
    },
    {
      "description": "Group all Docker Compose image non-major updates in one pull request, reviewed by a maintainer",
      "matchManagers": ["docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "groupName": "docker compose (non-major)"
    },
    {
      "description": "Group Hugo and Dart Sass minor and patch updates in one pull request, reviewed by a maintainer",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["hugo", "dart-sass"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "hugo toolchain"
    },
    {
      "description": "Update indirect Go modules (Hugo modules), so go.mod and go.sum stay current",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "enabled": true
    },
    {
      "description": "Group Go module minor and patch updates in one pull request, reviewed by a maintainer",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "go modules"
    },
    {
      "description": "Keep Node.js on major version 24 (LTS)",
      "matchPackageNames": ["node", "@types/node"],
      "matchManagers": ["npm", "nodenv", "dockerfile"],
      "allowedVersions": "^24.0.0"
    },
    {
      "description": "Label every update type and dependency in the pull request, also in a group (up to 15 dependencies)",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance",
        "rollback",
        "bump",
        "replacement"
      ],
      "addLabels": [
        "{{#if (includes (lookupArray upgrades \"updateType\") \"major\")}}major{{/if}}",
        "{{#if (includes (lookupArray upgrades \"updateType\") \"minor\")}}minor{{/if}}",
        "{{#if (includes (lookupArray upgrades \"updateType\") \"patch\")}}patch{{/if}}",
        "{{#if (includes (lookupArray upgrades \"updateType\") \"pin\")}}pin{{/if}}",
        "{{#if (includes (lookupArray upgrades \"updateType\") \"pinDigest\")}}pinDigest{{/if}}",
        "{{#if (includes (lookupArray upgrades \"updateType\") \"digest\")}}digest{{/if}}",
        "{{#if (includes (lookupArray upgrades \"updateType\") \"lockFileMaintenance\")}}lockFileMaintenance{{/if}}",
        "{{#if (includes (lookupArray upgrades \"updateType\") \"rollback\")}}rollback{{/if}}",
        "{{#if (includes (lookupArray upgrades \"updateType\") \"bump\")}}bump{{/if}}",
        "{{#if (includes (lookupArray upgrades \"updateType\") \"replacement\")}}replacement{{/if}}",
        "{{{lookup (distinct (lookupArray upgrades \"depName\")) 0}}}",
        "{{{lookup (distinct (lookupArray upgrades \"depName\")) 1}}}",
        "{{{lookup (distinct (lookupArray upgrades \"depName\")) 2}}}",
        "{{{lookup (distinct (lookupArray upgrades \"depName\")) 3}}}",
        "{{{lookup (distinct (lookupArray upgrades \"depName\")) 4}}}",
        "{{{lookup (distinct (lookupArray upgrades \"depName\")) 5}}}",
        "{{{lookup (distinct (lookupArray upgrades \"depName\")) 6}}}",
        "{{{lookup (distinct (lookupArray upgrades \"depName\")) 7}}}",
        "{{{lookup (distinct (lookupArray upgrades \"depName\")) 8}}}",
        "{{{lookup (distinct (lookupArray upgrades \"depName\")) 9}}}",
        "{{{lookup (distinct (lookupArray upgrades \"depName\")) 10}}}",
        "{{{lookup (distinct (lookupArray upgrades \"depName\")) 11}}}",
        "{{{lookup (distinct (lookupArray upgrades \"depName\")) 12}}}",
        "{{{lookup (distinct (lookupArray upgrades \"depName\")) 13}}}",
        "{{{lookup (distinct (lookupArray upgrades \"depName\")) 14}}}"
      ]
    },
    {
      "description": "Mark dependencies",
      "matchDepTypes": ["dependencies"],
      "addLabels": ["dependencies"]
    },
    {
      "description": "Mark dev dependencies",
      "matchDepTypes": ["devDependencies"],
      "addLabels": ["dev dependencies"]
    }
  ],
  "internalChecksFilter": "none",
  "minimumReleaseAge": "3 days",
  "customManagers": [
    {
      "description": "Track Hugo version in GitHub Actions workflows",
      "customType": "regex",
      "managerFilePatterns": ["/.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": ["HUGO_VERSION:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "hugo",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "packageNameTemplate": "gohugoio/hugo"
    },
    {
      "description": "Track Dart Sass version in GitHub Actions workflows",
      "customType": "regex",
      "managerFilePatterns": ["/.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "DART_SASS_VERSION:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "dart-sass",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "packageNameTemplate": "sass/dart-sass"
    }
  ]
}
