/.github/super_linter.env             @homelab-alpha
/.github/workflows/                   @homelab-alpha
/.gitignore                           @homelab-alpha
/.npmrc                               @homelab-alpha
/.pre-commit-config.yaml              @homelab-alpha
/.prettierignore                      @homelab-alpha
/.prettierrc                          @homelab-alpha
/package-lock.json                    @homelab-alpha
/package.json                         @homelab-alpha

